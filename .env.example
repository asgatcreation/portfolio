# Copy to .env and fill in. Never commit .env.
# Build-time (used by `npm run build`)
# Public URL of the site once the domain is chosen (enables canonical URLs and the sitemap).
SITE_URL=
# Cloudflare Turnstile SITE key (public, safe in the page). Leave empty to show no spam check.
PUBLIC_TURNSTILE_SITE_KEY=

# Run-time, for the contact function (set these in the Cloudflare Pages dashboard, not here).
# Brevo HTTP API key: the form cannot send without it.
BREVO_API_KEY=
# Where messages are delivered, and a sender address verified in Brevo.
CONTACT_TO=
CONTACT_FROM=
# Turnstile SECRET key. When set, the function refuses a message with no valid token.
TURNSTILE_SECRET_KEY=
# Set to "off" to stop the automatic acknowledgement to the visitor.
CONTACT_AUTOREPLY=
# Later milestones.
GITHUB_TOKEN=
