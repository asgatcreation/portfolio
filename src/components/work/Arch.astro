---
/** Architecture: who uses it → the application → data → outside services. */
interface Props {
  arch: Record<string, string[]>;
}
const cols = Object.entries(Astro.props.arch).filter(([, v]) => v.length > 0);
---

<div class="arch" style={`--cols:${cols.length}`}>
  {cols.map(([name, nodes], i) => (
    <>
      {i > 0 && (
        <div class="arch-link" aria-hidden="true">
          <i />
        </div>
      )}
      <div class="arch-col" role="group" aria-label={name}>
        <p class="arch-h">{name}</p>
        {nodes.map((n) => (
          <div class="node">{n}</div>
        ))}
      </div>
    </>
  ))}
</div>
