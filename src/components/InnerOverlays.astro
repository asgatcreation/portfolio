---
import { publishedProjects } from '../data/projects';

const projects = await publishedProjects();
const pages: [string, string, string][] = [
  ['About', '/about/', 'Story, experience, education'],
  ['All projects', '/work/', 'Every project and its true status'],
  ['Services', '/services/', 'What I do and how we work'],
  ['Research & data', '/research/', 'Findings, datasets and surveys'],
  ['Lab', '/lab/', 'Three small tools that run in the page'],
  ['AsgatArticles', '/writing/', 'Writing on tech and data'],
  ['CV', '/cv/', 'Full CV and five PDF downloads'],
  ['Now', '/now/', 'What I am working on this month'],
  ['Uses', '/uses/', 'The tools I build with'],
  ['Privacy', '/privacy/', 'What this site collects: almost nothing'],
  ['Home', '/', 'Back to the start'],
];
const items = [
  ...pages.map(([t, href, s]) => ({ g: 'Pages', t, s, href })),
  ...projects.map((p) => ({
    g: 'Projects',
    t: p.title,
    s: `${p.statusLabel} · ${p.categories.join(', ')}`,
    href: `/work/${p.id}/`,
  })),
];
const navData = JSON.stringify(items).replace(/</g, '\u003c');
---

<button class="totop" type="button" aria-label="Back to top" data-totop>
  <svg class="ringp" viewBox="0 0 50 50" aria-hidden="true">
    <circle
      cx="25"
      cy="25"
      r="24"
      fill="none"
      stroke="var(--gold)"
      stroke-width="2"
      stroke-dasharray="150.8"
      stroke-dashoffset="150.8"
      data-totop-ring
    />
  </svg>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5M6 11l6-6 6 6" />
  </svg>
</button>

<!-- Lightbox -->
<div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Screenshot viewer">
  <button class="icon-btn lb-close" type="button" data-lb-close aria-label="Close screenshot">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  </button>
  <button class="icon-btn lb-prev" type="button" data-lb-prev aria-label="Previous screenshot">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="m15 6-6 6 6 6" />
    </svg>
  </button>
  <figure>
    <img data-lb-img alt="" />
    <figcaption data-lb-cap></figcaption>
  </figure>
  <button class="icon-btn lb-next" type="button" data-lb-next aria-label="Next screenshot">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="m9 6 6 6-6 6" />
    </svg>
  </button>
</div>

<!-- Command palette -->
<div class="palette" data-palette hidden>
  <div class="p-scrim" data-palette-close></div>
  <div class="p-box" role="dialog" aria-modal="true" aria-label="Search the site">
    <div class="p-input">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
      <input
        type="text"
        placeholder="Search projects, articles and pages…"
        aria-label="Search"
        role="combobox"
        aria-expanded="true"
        aria-controls="p-list"
        aria-autocomplete="list"
        data-palette-input
      />
      <kbd>Esc</kbd>
    </div>
    <div class="p-list" id="p-list" role="listbox" aria-label="Results" data-palette-list></div>
    <div class="p-foot">
      <span>
        <kbd>↑</kbd>
        <kbd>↓</kbd> move
      </span>
      <span>
        <kbd>Enter</kbd> open
      </span>
    </div>
  </div>
</div>

<script type="application/json" id="site-nav-data" set:html={navData} />
<div class="toast" data-toast role="status" aria-live="polite"></div>
