<!-- OPEN SOURCE -->
<section class="block" id="open-source" aria-labelledby="oss-title">
  <div class="oss">
    <div>
      <span class="eyebrow rv">Open source</span>
      <h2 id="oss-title" class="rv d1">
        Install it in <span class="grad-text">one line.</span>
      </h2>
      <p class="lead rv d2">
        naija-data gives Nigerian developers states, LGAs, wards, banks and phone rules, with a source for every row and
        the same answers in Python, JavaScript and Go.
      </p>
      <div class="copyrow rv d3">
        <button class="btn sm" type="button" data-copy="pip install naija-data">
          Copy pip
        </button>
        <button class="btn sm" type="button" data-copy="npm install naija-data">
          Copy npm
        </button>
        <button class="btn sm" type="button" data-copy="go get github.com/asgatcreation/naija-data/go">
          Copy go
        </button>
      </div>
    </div>
    <div class="term rv d2">
      <div class="term-top">
        <i></i>
        <i></i>
        <i></i>
        <span>~/project</span>
        <div class="term-tabs" role="group" aria-label="Language">
          <button type="button" aria-pressed="true" data-lang="py">
            python
          </button>
          <button type="button" aria-pressed="false" data-lang="js">
            node
          </button>
          <button type="button" aria-pressed="false" data-lang="go">
            go
          </button>
        </div>
      </div>
      <pre aria-live="off" data-term><span class="p">$</span> pip install naija-data</pre>
    </div>
  </div>
</section>
