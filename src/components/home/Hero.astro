---
// The hero of a portfolio, not of a product. The work is visible before the visitor scrolls:
// the right-hand side is a real screenshot of a real, live project, in a real browser frame.
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', (p) => !p.data.draft);
const lead = projects.find((p) => p.id === 'carhub');
if (!lead) throw new Error('Hero needs the CarHub project; it is missing from src/content/projects.');
const cover = lead.data.cover;
if (!cover) throw new Error('Hero needs CarHub to have a cover image.');
// shots are [src, alt] pairs
const coverAlt = lead.data.shots.find(([src]) => src === cover)?.[1] ?? `A screen from ${lead.data.title}`;
---

<!-- HERO -->
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="blob a" aria-hidden="true"></div>
  <div class="blob b" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-text">
      <p class="eyebrow-name">
        Akanji Oluwaseun Gabriel <span aria-hidden="true">—</span>
        <span class="sr">,</span> Software engineer, data scientist &amp; statistician
      </p>
      <h1 id="hero-title">
        <span class="line">
          <span>I code. I build.</span>
        </span>
        <span class="line">
          <span>
            I make <span class="grad-text">impact.</span>
          </span>
        </span>
      </h1>
      <p class="typed">
        I build products that ship and analysis that holds up — across fintech, edtech, agritech, health, commerce and
        public data.
      </p>
      <div class="ctas">
        <a class="btn gold magnetic" href="#work">
          See the work{' '}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a class="btn magnetic" href="#contact" data-goto-tab="book">
          Book a call
        </a>
      </div>
      <p class="avail-line">
        <span class="dot" aria-hidden="true"></span>Available for freelance, contract &amp; full-time
      </p>
      <div class="socials">
        <span>Find me</span>
        <a
          href="https://github.com/asgatcreation"
          target="_blank"
          rel="noopener"
          aria-label="GitHub (opens in a new tab)"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z" />
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/oluwaseun-akanji-1361a2127/"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn (opens in a new tab)"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.5 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3 8.5h3V21H3zM9 8.5h2.9v1.7c.5-.9 1.7-2 3.7-2 3.6 0 4.4 2.3 4.4 5.4V21h-3v-6.6c0-1.6 0-3.5-2.2-3.5S12 12.6 12 14.3V21H9z" />
          </svg>
        </a>
        <a href="https://twitter.com/Iam_Asgat" target="_blank" rel="noopener" aria-label="X (opens in a new tab)">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3.5 3h4.8l4.1 5.7L17.4 3h2.7l-6.5 7.5L21 21h-4.8l-4.6-6.3L6.1 21H3.4l7-8z" />
          </svg>
        </a>
      </div>
    </div>

    <a class="shotframe" href="#work" aria-label={`Featured project: ${lead.data.title}`}>
      <div class="chrome">
        <span class="dots" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span class="url">{lead.data.demo?.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
      </div>
      <img src={cover} alt={coverAlt} width="1280" height="800" loading="eager" />
      <span class="shot-tag">
        <b>{lead.data.title}</b>
        <em>{lead.data.tagline}</em>
      </span>
    </a>
  </div>
  <a class="scroll-hint" href="#about" aria-label="Scroll to About">
    <i></i>Scroll
  </a>
</section>

<div class="marquee" aria-label="Technologies I use">
  <ul data-marquee>
    <li>Python</li>
    <li>Django</li>
    <li>TypeScript</li>
    <li>Laravel</li>
    <li>Vue</li>
    <li>React</li>
    <li>Next.js</li>
    <li>PostgreSQL</li>
    <li>WebSockets</li>
    <li>Redis</li>
    <li>Go</li>
    <li>R</li>
    <li>Statistics</li>
    <li>Flutter</li>
    <li>FastAPI</li>
    <li>NestJS</li>
    <li>Stata</li>
    <li>SPSS</li>
    <li>Paystack</li>
    <li>Docker</li>
    <li>Cloudflare Workers</li>
  </ul>
</div>
