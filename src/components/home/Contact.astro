<!-- CONTACT -->
<section class="block" id="contact" aria-labelledby="contact-title">
  <div class="contact3 rv">
    <aside class="c3-side">
      <span class="eyebrow">Contact</span>
      <h2 id="contact-title">
        Let’s build something <span class="grad-text">great.</span>
      </h2>
      <p class="c3-intro">
        Tell me about your project, job or idea. Any industry, any size. Pick whatever is easiest for you.
      </p>
      <div class="clock">
        <span class="live-dot" aria-hidden="true"></span>
        <span>My time in Oyo, Nigeria</span>
        <b data-clock>--:--</b>
        <small data-clock-note></small>
      </div>
      <ul class="channels">
        <li>
          <a href="mailto:asgatcreation@gmail.com">
            <span class="ic">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            </span>
            <span>
              <small>Email</small>
              <b>asgatcreation@gmail.com</b>
            </span>
          </a>
          <button class="copy-mini" type="button" data-copy="asgatcreation@gmail.com" aria-label="Copy email address">
            Copy
          </button>
        </li>
        <li>
          <a href="https://wa.me/2348160948723" target="_blank" rel="noopener">
            <span class="ic wa">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.6a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z" />
              </svg>
            </span>
            <span>
              <small>WhatsApp</small>
              <b>+234 816 094 8723</b>
            </span>
            <span class="arr" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
        <li>
          <a href="tel:+2348160948723">
            <span class="ic">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
              </svg>
            </span>
            <span>
              <small>Phone</small>
              <b>Call me</b>
            </span>
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/in/oluwaseun-akanji-1361a2127/" target="_blank" rel="noopener">
            <span class="ic">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4.5 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3 8.5h3V21H3zM9 8.5h2.9v1.7c.5-.9 1.7-2 3.7-2 3.6 0 4.4 2.3 4.4 5.4V21h-3v-6.6c0-1.6 0-3.5-2.2-3.5S12 12.6 12 14.3V21H9z" />
              </svg>
            </span>
            <span>
              <small>LinkedIn</small>
              <b>Oluwaseun Akanji</b>
            </span>
            <span class="arr" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      </ul>
      <p class="c3-foot">Open to freelance, contract and full-time work, remote or in Nigeria.</p>
    </aside>

    <div class="c3-main">
      <div class="c3-tabs" role="tablist" aria-label="How would you like to reach me?">
        <button type="button" role="tab" id="ct-msg" aria-controls="cp-msg" aria-selected="true" data-ctab="msg">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg>
          Send a message
        </button>
        <button
          type="button"
          role="tab"
          id="ct-book"
          aria-controls="cp-book"
          aria-selected="false"
          tabindex="-1"
          data-ctab="book"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
          </svg>
          Book a call
        </button>
        <button
          type="button"
          role="tab"
          id="ct-wa"
          aria-controls="cp-wa"
          aria-selected="false"
          tabindex="-1"
          data-ctab="wa"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z" />
          </svg>
          WhatsApp
        </button>
      </div>

      <!-- 1. Message -->
      <form class="c3-panel" role="tabpanel" id="cp-msg" aria-labelledby="ct-msg" novalidate data-msg-form>
        <div class="row2">
          <div class="fld">
            <label for="m-name">
              Full name <i>*</i>
            </label>
            <input id="m-name" name="name" type="text" autocomplete="name" required placeholder="e.g. Ada Obi" />
            <span class="err">Please enter your name.</span>
          </div>
          <div class="fld">
            <label for="m-email">
              Email <i>*</i>
            </label>
            <input id="m-email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
            <span class="err">Please enter a valid email.</span>
          </div>
        </div>
        <div class="row2">
          <div class="fld">
            <label for="m-phone">Phone or WhatsApp</label>
            <input id="m-phone" name="phone" type="tel" autocomplete="tel" placeholder="Optional" />
          </div>
          <div class="fld">
            <label for="m-org">Company or organisation</label>
            <input id="m-org" name="org" type="text" autocomplete="organization" placeholder="Optional" />
          </div>
        </div>
        <div class="fld">
          <span class="lbl" id="m-topic-l">
            I’m reaching out about
          </span>
          <div class="pills" role="radiogroup" aria-labelledby="m-topic-l">
            <label>
              <input type="radio" name="topic" value="A new project" checked />
              <span>A new project</span>
            </label>
            <label>
              <input type="radio" name="topic" value="A full-time role" />
              <span>A full-time role</span>
            </label>
            <label>
              <input type="radio" name="topic" value="Contract work" />
              <span>Contract work</span>
            </label>
            <label>
              <input type="radio" name="topic" value="Data or statistics work" />
              <span>Data / statistics</span>
            </label>
            <label>
              <input type="radio" name="topic" value="Consulting or training" />
              <span>Consulting / training</span>
            </label>
            <label>
              <input type="radio" name="topic" value="Something else" />
              <span>Something else</span>
            </label>
          </div>
        </div>
        <div class="row2">
          <div class="fld">
            <label for="m-budget">Budget</label>
            <select id="m-budget" name="budget">
              <option>Not sure yet</option>
              <option>Under ₦500,000</option>
              <option>₦500,000 – ₦2,000,000</option>
              <option>₦2,000,000 – ₦5,000,000</option>
              <option>Above ₦5,000,000</option>
              <option>Salaried role</option>
            </select>
          </div>
          <div class="fld">
            <label for="m-when">Timeline</label>
            <select id="m-when" name="when">
              <option>As soon as possible</option>
              <option>In 1–3 months</option>
              <option>Later this year</option>
              <option>Just exploring</option>
            </select>
          </div>
        </div>
        <div class="fld">
          <label for="m-msg">
            Message <i>*</i>{' '}
            <span class="chars" data-chars>
              0 / 2000
            </span>
          </label>
          <textarea
            id="m-msg"
            name="message"
            required
            minlength="10"
            maxlength="2000"
            placeholder="What are you building, who is it for, and what must not go wrong?"
          ></textarea>
          <span class="err">A few more words, please (at least 10 characters).</span>
        </div>
        <div class="c3-actions">
          <button class="btn gold" type="submit" data-send="email">
            Send message{' '}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22 2 11 13M22 2l-7 20-4-9-9-4z" />
            </svg>
          </button>
          <button class="btn wa-btn" type="button" data-send="wa">
            Send on WhatsApp
          </button>
        </div>
        <div class="sent" role="status" data-msg-status></div>
      </form>

      <!-- 2. Booking -->
      <form class="c3-panel" role="tabpanel" id="cp-book" aria-labelledby="ct-book" hidden novalidate data-book-form>
        <div class="fld">
          <span class="lbl" id="b-day-l">
            1. Pick a day
          </span>
          <div class="days" role="radiogroup" aria-labelledby="b-day-l" data-days></div>
        </div>
        <div class="fld">
          <span class="lbl" id="b-time-l">
            2. Pick a time <small>(West Africa Time)</small>
          </span>
          <div class="pills" role="radiogroup" aria-labelledby="b-time-l" data-slots></div>
        </div>
        <div class="fld">
          <span class="lbl" id="b-type-l">
            3. How should we talk?
          </span>
          <div class="pills" role="radiogroup" aria-labelledby="b-type-l">
            <label>
              <input type="radio" name="via" value="Google Meet" checked />
              <span>Google Meet</span>
            </label>
            <label>
              <input type="radio" name="via" value="Zoom" />
              <span>Zoom</span>
            </label>
            <label>
              <input type="radio" name="via" value="Phone call" />
              <span>Phone call</span>
            </label>
            <label>
              <input type="radio" name="via" value="WhatsApp call" />
              <span>WhatsApp call</span>
            </label>
          </div>
        </div>
        <div class="row2">
          <div class="fld">
            <label for="b-name">
              Full name <i>*</i>
            </label>
            <input id="b-name" name="name" type="text" autocomplete="name" required />
            <span class="err">Please enter your name.</span>
          </div>
          <div class="fld">
            <label for="b-email">
              Email <i>*</i>
            </label>
            <input id="b-email" name="email" type="email" autocomplete="email" required />
            <span class="err">Please enter a valid email.</span>
          </div>
        </div>
        <div class="fld">
          <label for="b-about">What would you like to talk about?</label>
          <input
            id="b-about"
            name="about"
            type="text"
            placeholder="e.g. a school management app, a survey dashboard…"
          />
        </div>
        <div class="summary" data-book-summary aria-live="polite"></div>
        <div class="c3-actions">
          <button class="btn gold" type="submit" data-book="email">
            Request this call
          </button>
          <button class="btn wa-btn" type="button" data-book="wa">
            Request on WhatsApp
          </button>
        </div>
        <div class="sent" role="status" data-book-status></div>
      </form>

      <!-- 3. WhatsApp -->
      <div class="c3-panel wa-panel" role="tabpanel" id="cp-wa" aria-labelledby="ct-wa" hidden>
        <div class="wa-card">
          <span class="ic wa big">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.6a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z" />
            </svg>
          </span>
          <h3>Chat with me on WhatsApp</h3>
          <p>+234 816 094 8723 · the quickest way to reach me.</p>
          <p class="lbl">Start with a message:</p>
          <div class="quick" data-quick>
            <a
              href="https://wa.me/2348160948723?text=Hello%20Gabriel%2C%20I%20have%20a%20project%20I%E2%80%99d%20like%20to%20discuss."
              target="_blank"
              rel="noopener"
              data-wa-text="Hello Gabriel, I have a project I’d like to discuss."
            >
              I have a project
            </a>
            <a
              href="https://wa.me/2348160948723?text=Hello%20Gabriel%2C%20I%E2%80%99d%20like%20to%20talk%20about%20hiring%20you."
              target="_blank"
              rel="noopener"
              data-wa-text="Hello Gabriel, I’d like to talk about hiring you."
            >
              I’d like to hire you
            </a>
            <a
              href="https://wa.me/2348160948723?text=Hello%20Gabriel%2C%20I%20need%20help%20with%20data%20analysis%20or%20statistics."
              target="_blank"
              rel="noopener"
              data-wa-text="Hello Gabriel, I need help with data analysis or statistics."
            >
              Data / statistics help
            </a>
            <a
              href="https://wa.me/2348160948723?text=Hello%20Gabriel%2C%20I%E2%80%99d%20like%20to%20book%20a%20call."
              target="_blank"
              rel="noopener"
              data-wa-text="Hello Gabriel, I’d like to book a call."
            >
              Book a call
            </a>
          </div>
          <a class="btn wa-btn big" href="https://wa.me/2348160948723" target="_blank" rel="noopener">
            Open WhatsApp ↗
          </a>
        </div>
      </div>
      <p class="form-note" data-form-note>
        Your message goes straight to my inbox or WhatsApp.
      </p>
    </div>
  </div>
</section>
