---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Show the loading screen (home page only). */
  loader?: boolean;
  home?: boolean;
  /** Social preview card, from public/og/. Built by `npm run og`. */
  image?: string;
  /** What the card shows, for anyone using a screen reader on the post that links here. */
  imageAlt?: string;
  /** Extra schema.org data for this page, alongside the site-wide Person. */
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = site.description,
  loader = false,
  image = '/og/default.png',
  imageAlt,
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.headline}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Social networks only accept absolute image URLs, so the card is emitted once SITE_URL is set.
const cardUrl = Astro.site ? new URL(image, Astro.site).href : undefined;
const cardAlt = imageAlt ?? `${fullTitle} — asgatcreation`;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.brand,
  jobTitle: 'Software engineer, data scientist and statistician',
  description: site.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Oyo', addressCountry: 'NG' },
  sameAs: [site.github, site.linkedin, site.x],
  ...(Astro.site ? { url: Astro.site.href, image: new URL('/img/logo-avatar.jpg', Astro.site).href } : {}),
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    {canonical && <meta property="og:url" content={canonical} />}
    {cardUrl && (
      <>
        <meta property="og:image" content={cardUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={cardAlt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {cardUrl && <meta name="twitter:image" content={cardUrl} />}
    {cardUrl && <meta name="twitter:image:alt" content={cardAlt} />}
    <meta name="twitter:creator" content="@Iam_Asgat" />
    <meta name="theme-color" content="#000000" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href="/img/logo-avatar.jpg" />
    <script is:inline>
      /* One theme only: black and gold, taken from the logo. Clear any choice an
         earlier version of the site stored, so nobody is left on a theme that no
         longer exists. */
      try {
        localStorage.removeItem('theme');
      } catch {
        /* storage blocked: nothing to clear */
      }
      document.documentElement.classList.add('js');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class:list={[{ 'no-loader': !loader }]}>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <slot name="overlays" />
  </body>
</html>
