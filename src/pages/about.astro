---
import Base from '../layouts/Base.astro';
import InnerOverlays from '../components/InnerOverlays.astro';
import { cvs, site } from '../data/site';
---

<Base
  title="About"
  description="Akanji Oluwaseun Gabriel: Statistician I at Nigeria's National Bureau of Statistics, full-stack software engineer and data scientist, based in Oyo, Nigeria."
>
  <main id="main" class="page">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">home</a> / <span aria-current="page">about</span>
      </nav>
      <header class="page-head">
        <span class="eyebrow">About me</span>
        <h1>Engineer, data scientist and statistician.</h1>
        <p>
          The long version: where I work, what I have shipped, what I studied, and how to reach me. The short version is
          on the{' '}
          <a class="linkish" href="/#about">
            home page
          </a>
          .
        </p>
      </header>

      <article class="case">
        <section class="v-sec">
          <div class="about">
            <div class="suitframe rv">
              <div class="sf-bg" aria-hidden="true">
                <span class="sf-ring"></span>
                <span class="sf-ring r2"></span>
                <span class="sf-grid"></span>
              </div>
              <img
                class="sf-me"
                src="/img/me-suit.png"
                alt="Portrait of Akanji Oluwaseun Gabriel in a dark suit and gold tie"
                width="498"
                height="760"
                loading="lazy"
              />
              <div class="sf-card">
                <img src="/img/logo-avatar.jpg" alt="" width="44" height="44" loading="lazy" />
                <span>
                  <b>Akanji Oluwaseun Gabriel</b>
                  <small>Statistician · Engineer · Data scientist</small>
                </span>
              </div>
              <div class="sf-badge">
                <b>5+</b>years in official
                <br />
                statistics (NBS)
              </div>
            </div>
            <div>
              <div class="roles rv" aria-label="What I do">
                <span>Full-stack engineer</span>
                <span>Web &amp; mobile</span>
                <span>Data scientist</span>
                <span>Statistician</span>
                <span>Mathematician</span>
                <span>Team lead</span>
              </div>
              <p class="lead rv">
                I work in two worlds that help each other: <em>official statistics</em>, where a number has to survive
                being checked, and <em>software</em>, where a system has to keep working when real people depend on it.
              </p>
              <p class="rv">
                By day I am a Statistician I at the National Bureau of Statistics in Oyo State. I lead and supervise
                field teams on national surveys, train enumerators, and clean and analyse the data that comes back —
                work done with partners including FAO, UNICEF and UNODC. That job teaches you something software people
                often learn late: a result nobody can check is worth nothing.
              </p>
              <p class="rv">
                The rest of my time goes into building software. I have shipped a live car marketplace with real-time
                trip tracking, a back office for POS agents built on a double-entry ledger, a personal finance app, a
                task manager, and open-source data packages that Nigerian developers can install in Python, JavaScript
                and Go. I am now building clinic software, a live auction platform and a payments library.
              </p>
              <p class="rv">
                I am trained in mathematics — two master's degrees from the University of Ibadan, the second still in
                progress — so the hard parts are the parts I enjoy: ledgers that must balance, tenant isolation that
                must not leak, bid engines that must behave under a race.
              </p>
              <p class="rv">
                I take on work for anyone who needs something built, measured or explained: startups, small and growing
                businesses, NGOs and development partners, schools and ed-tech teams, farms and agri businesses,
                government and research teams. Freelance, contract or full-time. Fintech, edtech, agritech, health,
                e-commerce, logistics, sport and public data — I have worked across all of them.
              </p>
              <dl class="facts rv">
                <div>
                  <dt>Based in</dt>
                  <dd>{site.location} · WAT (UTC+1)</dd>
                </div>
                <div>
                  <dt>Day job</dt>
                  <dd>Statistician I, NBS</dd>
                </div>
                <div>
                  <dt>Education</dt>
                  <dd>MSc Mathematics · MSc Statistics (in progress)</dd>
                </div>
                <div>
                  <dt>Speaks</dt>
                  <dd>English · Yoruba</dd>
                </div>
              </dl>
              <div class="v-ctas">
                <a class="btn gold" href="/cv/">
                  Read my CV
                </a>
                <a class="btn" href="/#contact">
                  Get in touch
                </a>
              </div>
            </div>
          </div>
        </section>

        <section class="v-sec">
          <h2 class="v-h">
            <span>Experience</span>
            <small>01</small>
          </h2>
          <div class="journey">
            <div class="tl">
              <h3>Statistics &amp; survey work</h3>
              <ol>
                <li>
                  <span class="when">2022 – present</span>
                  <b>Statistician I</b>
                  <span class="where">National Bureau of Statistics (NBS), Oyo State</span>
                  <p>
                    Lead and supervise field teams on national surveys; quality control, CAPI data collection, cleaning
                    and analysis in Stata, SPSS and CSPro; train and mentor enumerators.
                  </p>
                  <ul class="roles-mini">
                    <li>
                      <b>Team Lead</b> · Crop Cutting Pilot Survey, NBS × FAO · 2026 –
                    </li>
                    <li>
                      <b>Assistant Team Supervisor</b> · MICS 7, NBS × UNICEF · 2025–26
                    </li>
                    <li>
                      <b>Supervising Field Officer</b> · IPCCS 2024
                    </li>
                    <li>
                      <b>Team Lead Field Officer</b> · UNODC–NBS Public Integrity Survey · 2023
                    </li>
                    <li>
                      <b>Field Officer</b> · Quarterly GDP and monthly CPI surveys
                    </li>
                  </ul>
                </li>
                <li>
                  <span class="when">2020 – 2022</span>
                  <b>Ad-hoc Field Officer</b>
                  <span class="where">NBS, Oyo State</span>
                  <p>National Agricultural Sample Census 2022 (listing) and National Business Sample Census 2020.</p>
                </li>
              </ol>
            </div>
            <div class="tl">
              <h3>Software &amp; other roles</h3>
              <ol>
                <li>
                  <span class="when">Ongoing</span>
                  <b>Full-stack software engineer</b>
                  <span class="where">asgatcreation · independent</span>
                  <p>
                    Designed, built and shipped CarHub, FloatBook, FinanceFlow, TaskFlow and naija-data; now building
                    Curavia, Ojà Live, naija-pay and Scoreline. See{' '}
                    <a class="linkish" href="/work/">
                      all projects
                    </a>
                    .
                  </p>
                </li>
                <li>
                  <span class="when">2020 – 2024</span>
                  <b>Administrative Officer</b>
                  <span class="where">Sword of the Spirit Ministries, Ibadan</span>
                  <p>Administration and data reports for 81 churches.</p>
                </li>
                <li>
                  <span class="when">2016 – 2018</span>
                  <b>Mathematics Teacher</b>
                  <span class="where">Army Day Secondary School (NYSC) · Class International School</span>
                  <p>Taught mathematics to secondary classes and prepared students for external examinations.</p>
                </li>
              </ol>
            </div>
          </div>
          <div class="partners">
            <span>Survey work with</span>
            <b>NBS</b>
            <b>FAO</b>
            <b>UNICEF</b>
            <b>UNODC</b>
          </div>
        </section>

        <section class="v-sec">
          <h2 class="v-h">
            <span>Education &amp; training</span>
            <small>02</small>
          </h2>
          <div class="journey">
            <div class="tl">
              <h3>Degrees</h3>
              <ol>
                <li>
                  <span class="when">2025 – present</span>
                  <b>MSc Statistics (in progress)</b>
                  <span class="where">University of Ibadan</span>
                  <p>Dissertation: Modified Three-Parameter Rama Distribution and Its Applications.</p>
                </li>
                <li>
                  <span class="when">2018 – 2021</span>
                  <b>MSc Mathematics</b>
                  <span class="where">University of Ibadan</span>
                  <p>Dissertation: Compact Lie Groups and the Fourier–Stieltjes Transform of Vector Measures.</p>
                </li>
                <li>
                  <span class="when">2012 – 2016</span>
                  <b>BSc Mathematics, Second Class Upper</b>
                  <span class="where">University of Ilorin</span>
                  <p>MTN Foundation Scholar.</p>
                </li>
              </ol>
            </div>
            <div class="tl">
              <h3>Certificates &amp; training</h3>
              <ul class="certs">
                <li>
                  <b>Applied Artificial Intelligence Programme</b>
                  <span>Patwillsvision &amp; Rollascriptings · 2026</span>
                </li>
                <li>
                  <b>Data Science and Machine Learning</b>
                  <span>Muzedata · certificate</span>
                </li>
                <li>
                  <b>Full-Stack Web Development</b>
                  <span>Zuri Training × I4G · 2022–23</span>
                </li>
                <li>
                  <b>Sage Days 102 (SageMath)</b>
                  <span>OpenDreamKit &amp; University of Ibadan · 2019</span>
                </li>
                <li>
                  <b>Python Workshop for Scientists in Africa</b>
                  <span>University of Ibadan · 2018</span>
                </li>
              </ul>
              <div class="soft">
                <h3>Also</h3>
                <ul>
                  <li>Breaking big products into milestones</li>
                  <li>Writing clear docs and READMEs</li>
                  <li>Testing before shipping</li>
                  <li>Explaining technical choices simply</li>
                  <li>Mentoring and pair programming</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <section class="v-sec">
          <h2 class="v-h">
            <span>Download my CV</span>
            <small>03</small>
          </h2>
          <p>Five versions, depending on what you are hiring for. The full one has everything.</p>
          <ul class="dl-list">
            {cvs.map(([name, note, file]) => (
              <li>
                <a href={`/cv/${file}`} download>
                  <b>{name}</b>
                  <small>{note}</small>
                  <span aria-hidden="true">PDF ↓</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="art-note">
            Prefer to read it here? The same facts are on the{' '}
            <a class="linkish" href="/cv/">
              CV page
            </a>
            .
          </p>
        </section>
      </article>
    </div>
  </main>
  <InnerOverlays slot="overlays" />
  <script src="../scripts/site.js"></script>
</Base>
