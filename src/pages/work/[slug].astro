---
import Base from '../../layouts/Base.astro';
import InnerOverlays from '../../components/InnerOverlays.astro';
import Radar from '../../components/work/Radar.astro';
import Bars from '../../components/work/Bars.astro';
import Arch from '../../components/work/Arch.astro';
import Gallery from '../../components/work/Gallery.astro';
import { publishedProjects, type Project } from '../../data/projects';
import { radarAxes, statusName } from '../../data/site';

export async function getStaticPaths() {
  const all = await publishedProjects();
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: all[(i - 1 + all.length) % all.length], next: all[(i + 1) % all.length] },
  }));
}
interface Props {
  project: Project;
  prev: Project;
  next: Project;
}
const { project: p, prev, next } = Astro.props;

let n = 0;
const num = () => String(++n).padStart(2, '0');
const statusColor: Record<string, string> = {
  live: 'var(--live)',
  dev: 'var(--dev)',
  pre: 'var(--pre)',
  report: '#b48cff',
  private: '#ff9fd1',
  team: '#c9a7ff',
};
const pct = p.progress ? Math.round((p.progress[0] / p.progress[1]) * 100) : 0;
const charts = [p.chart, p.chart2].filter((c) => c !== undefined);
---

<Base title={`${p.title} · case study`} description={p.summary}>
  <main id="main" class="page">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">home</a> / <a href="/work/">work</a> / <span aria-current="page">{p.id}</span>
      </nav>
      <article class="case" style={`--c:${p.color}`}>
        <header class="v-hero">
          <div class="sc-chips">
            <span class="chip st2" style={`--c2:${statusColor[p.status]}`}>
              {p.statusLabel}
            </span>
            {p.categories.map((c) => (
              <span class="chip">{c}</span>
            ))}
          </div>
          <h1>{p.title}</h1>
          <p class="sc-tag">{p.tagline}</p>
          <p class="sc-sum">{p.summary}</p>
          {p.progress && (
            <div class="v-progress">
              <div class="meter in">
                <i style={`--w:${pct}%`} />
              </div>
              <p>
                {p.progress[0]} of {p.progress[1]} milestones · {pct}%
              </p>
            </div>
          )}
          <div class="v-ctas">
            {p.demo && (
              <a class="btn gold" href={p.demo} target="_blank" rel="noopener">
                {p.demoLabel ?? 'Open live demo'} ↗
              </a>
            )}
            {p.code ? (
              <a class="btn" href={p.code} target="_blank" rel="noopener">
                View code ↗
              </a>
            ) : (
              <span class="chip">Code private</span>
            )}
          </div>
        </header>

        {p.facts.length > 0 && (
          <div class="v-facts">
            {p.facts.map(([v, l]) => (
              <div>
                <b>{v}</b>
                <span>{l}</span>
              </div>
            ))}
          </div>
        )}

        <section class="v-sec">
          <h2 class="v-h">
            <span>Why I built it</span>
            <small>{num()}</small>
          </h2>
          <p class="v-why">{p.why ?? p.problem}</p>
          {p.why && (
            <p class="v-problem">
              <b>The problem: </b>
              {p.problem}
            </p>
          )}
        </section>

        {p.flow && (
          <section class="v-sec">
            <h2 class="v-h">
              <span>How it works</span>
              <small>{num()}</small>
            </h2>
            <ol class="flow">
              {p.flow.map((f, k) => (
                <li style={`--k:${k}`}>
                  <span>{k + 1}</span>
                  <b>{f}</b>
                </li>
              ))}
            </ol>
          </section>
        )}

        {p.parts ? (
          <section class="v-sec">
            <h2 class="v-h">
              <span>{p.parts.length} products in one</span>
              <small>{num()}</small>
            </h2>
            <div class="v-parts">
              {p.parts.map((pt, k) => (
                <a href={`#part-${k}`}>{pt.name}</a>
              ))}
            </div>
            {p.parts.map((pt, k) => (
              <div class="v-part" id={`part-${k}`}>
                <div>
                  <h3 class="h4">{pt.name}</h3>
                  <p>{pt.about}</p>
                  <ul class="feat">
                    {pt.features.map((f) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                </div>
                <Gallery shots={pt.shots} main group={`part-${k}`} />
              </div>
            ))}
          </section>
        ) : (
          <section class="v-sec">
            <h2 class="v-h">
              <span>What it does</span>
              <small>{num()}</small>
            </h2>
            {p.features && (
              <ul class="feat grid2">
                {p.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            )}
          </section>
        )}

        {(p.shots.length > 0 || p.extra) && (
          <section class="v-sec">
            <h2 class="v-h">
              <span>{p.parts ? 'Across the platform' : 'Screens'}</span>
              <small>{num()}</small>
            </h2>
            <Gallery shots={p.extra ?? p.shots} main={!p.extra} group="main" />
          </section>
        )}

        {p.arch && (
          <section class="v-sec">
            <h2 class="v-h">
              <span>Architecture</span>
              <small>{num()}</small>
            </h2>
            <Arch arch={p.arch} />
            <p class="art-note">How the parts connect, from the people using it to the services behind it.</p>
          </section>
        )}

        {((p.hard && p.hard.length > 0) || p.radar) && (
          <section class="v-sec">
            <h2 class="v-h">
              <span>Technical complexity</span>
              <small>{num()}</small>
            </h2>
            <div class="cx">
              {p.hard && p.hard.length > 0 && (
                <div class="hard">
                  {p.hard.map(([t, d], k) => (
                    <article>
                      <span>{String(k + 1).padStart(2, '0')}</span>
                      <h3 class="h4">{t}</h3>
                      <p>{d}</p>
                    </article>
                  ))}
                </div>
              )}
              {p.radar && <Radar values={p.radar} axes={radarAxes} />}
            </div>
          </section>
        )}

        {(charts.length > 0 || p.progress) && (
          <section class="v-sec">
            <h2 class="v-h">
              <span>Numbers &amp; charts</span>
              <small>{num()}</small>
            </h2>
            <div class="charts">
              {charts.map((c) => (
                <Bars title={c.title} note={c.note} rows={c.rows} unit={c.unit} max={c.max} log={c.log} />
              ))}
              {p.progress && (
                <Bars
                  title="Build progress"
                  note="Milestones completed"
                  rows={[
                    ['Done', p.progress[0]],
                    ['To go', p.progress[1] - p.progress[0]],
                  ]}
                  max={p.progress[1]}
                />
              )}
            </div>
          </section>
        )}

        <section class="v-sec">
          <h2 class="v-h">
            <span>Tech stack &amp; facts</span>
            <small>{num()}</small>
          </h2>
          <ul class="v-stack">
            {p.stack.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
          <dl class="v-meta">
            <div>
              <dt>Status</dt>
              <dd>{statusName[p.status]}</dd>
            </div>
            <div>
              <dt>Industry</dt>
              <dd>{p.industry ?? p.categories.join(', ')}</dd>
            </div>
            <div>
              <dt>Year</dt>
              <dd>{p.year}</dd>
            </div>
            <div>
              <dt>Languages</dt>
              <dd>{p.languages.join(', ')}</dd>
            </div>
          </dl>
          {p.note && (
            <div class="v-note">
              <b>Note</b>
              <span>{p.note}</span>
            </div>
          )}
        </section>

        <nav class="v-end" aria-label="More projects">
          <a href={`/work/${prev.id}/`}>
            <small>← Previous</small>
            <b>{prev.title}</b>
          </a>
          <a href={`/work/${next.id}/`}>
            <small>Next →</small>
            <b>{next.title}</b>
          </a>
        </nav>
      </article>
    </div>
  </main>
  <InnerOverlays slot="overlays" />
  <script src="../../scripts/site.js"></script>
</Base>
